{
  "family": "crucible-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/crucible-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/crucible-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "crucible-backend",
      "image": "ghcr.io/yapovazhnyi-blip/analytics-and-ml-portfolio/crucible-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "STORAGE_BACKEND", "value": "s3" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "DISABLE_AUTH", "value": "false" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:crucible/database-url"
        },
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:crucible/secret-key"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:crucible/anthropic-key"
        },
        {
          "name": "AWS_BUCKET_NAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:crucible/s3-bucket"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/crucible-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "crucible"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/api/v1/health/live || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
