# Crucible environment variables template.
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/crucible.db
# Production (PostgreSQL): DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/crucible

# ── Authentication ────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-secrets-token-hex-32
DISABLE_AUTH=false

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage

# S3 (when STORAGE_BACKEND=s3):
# AWS_BUCKET_NAME=my-crucible-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ── LLM / AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./data/mlruns

# ── Paths ─────────────────────────────────────────────────────────────────────
DATASET_STORAGE_PATH=./data/datasets
MODEL_STORAGE_PATH=./data/models
